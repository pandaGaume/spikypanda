{
    "compilerOptions": {
        "esModuleInterop": true,
        "baseUrl": "packages",
        "moduleResolution": "node",
        "module": "ES2020",
        "target": "ES2021",

        "declaration": true,
        "sourceMap": true,
        "inlineSources": true,
        "removeComments": false,
        "preserveConstEnums": true,
        "importHelpers": true,

        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,

        "noImplicitAny": true,
        "noImplicitOverride": false,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noUnusedLocals": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,

        "jsx": "react-jsx",

        "lib": [
            "es5", "dom",
            "es2015.promise", "es2015.collection",
            "es2015.iterable", "es2015.symbol.wellknown",
            "es2017", "es2019", "es2020.bigint"
        ],

        "paths": {
            "spikypanda-core": ["dev/core/src/index.ts"],
            "spikypanda-core/*": ["dev/core/src/*"],
            "spikypanda-nodeeditor": ["dev/nodeeditor/src/index.ts"],
            "spikypanda-nodeeditor/*": ["dev/nodeeditor/src/*"],
            "spikypanda-onnx": ["dev/onnx/src/index.ts"],
            "spikypanda-onnx/*": ["dev/onnx/src/*"],
            "spikypanda-sensors": ["dev/sensors/src/index.ts"],
            "spikypanda-sensors/*": ["dev/sensors/src/*"],
            "spikypanda-applications-stereo": ["dev/applications/stereo/src/index.ts"],
            "spikypanda-applications-stereo/*": ["dev/applications/stereo/src/*"],
            "spikypanda-applications-cardriver": ["dev/applications/privates/cardriver/src/index.ts"],
            "spikypanda-applications-cardriver/*": ["dev/applications/privates/cardriver/src/*"],
            "spikypanda-applications-driverv2": ["dev/applications/privates/driverv2/src/index.ts"],
            "spikypanda-applications-driverv2/*": ["dev/applications/privates/driverv2/src/*"],
            "spikypanda-applications-motorwatch": ["dev/applications/motorwatch/src/index.ts"],
            "spikypanda-applications-motorwatch/*": ["dev/applications/motorwatch/src/*"],
            "spikypanda-plugin-dsp": ["dev/plugins/dsp/src/index.ts"],
            "spikypanda-plugin-dsp/*": ["dev/plugins/dsp/src/*"],
            "spikypanda-plugin-ml": ["dev/plugins/ml/src/index.ts"],
            "spikypanda-plugin-ml/*": ["dev/plugins/ml/src/*"],
            "spikypanda-plugin-onnx": ["dev/plugins/onnx/src/index.ts"],
            "spikypanda-plugin-onnx/*": ["dev/plugins/onnx/src/*"],
            "spikypanda-plugin-physics": ["dev/plugins/physics/src/index.ts"],
            "spikypanda-plugin-physics/*": ["dev/plugins/physics/src/*"]
        },

        "types": ["reflect-metadata", "jest", "node"]
    },
    "exclude": ["**/node_modules", "**/dist"]
}
