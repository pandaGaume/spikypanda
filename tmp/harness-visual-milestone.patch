+@media(max-width:1000px) { main { grid-template-columns: 220px minmax(0,1fr); }.workspace { padding: 14px; }.bottom { grid-template-columns: 1fr; }.metrics div { padding: 12px; }.metrics strong { font-size: 21px; }.local { display:none; } }@media(max-width:700px) { main { display:block; } aside { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap: 15px; }#graph { height:350px; }h1 small { display:none; }.metrics { grid-template-columns:repeat(2,1fr); } }
