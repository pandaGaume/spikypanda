  "model": {
    "nodes": [
      {
        "id": "material",
        "label": "Oxide mix (synthetic test)",
        "typeId": "Chemistry.Material:test-oxide-mix",
        "data": {
          "enabled": true,
          "_presetId": "test-oxide-mix",
          "_displayName": "Oxide mix (synthetic test)",
          "_basis": "mass",
          "_componentsText": "SiO2:0.6, Fe2O3:0.2, CaCO3:0.15, MgO:0.05",
          "_provenance": "scenario of the LIBS brief, 2026-10-19. NOT a reference rock"
        }
      },
      {
        "id": "plasma",
        "label": "LIBS Plasma",
        "typeId": "Spectro.Libs:plasma",
        "data": {
          "enabled": true,
          "_temperatureK": 10000,
          "_electronDensityCm3": 100000000000000000,
          "_referenceElectronDensityCm3": 100000000000000000,
          "_collisionalWidthNm": 0.05,
          "_intensityScale": 1,
          "_continuumLevel": 0,
          "_emissionModel": "physical",
          "_catalogueChoice": "nist"
        }
      },
      {
        "id": "spectrometer",
        "label": "LIBS Spectrometer",
        "typeId": "Spectro.Instrument:spectrometer",
        "data": {
          "enabled": true,
          "_rangeStartNm": 240,
          "_rangeEndNm": 460,
          "_pixelCount": 2200,
          "_resolutionFwhmNm": 0.1,
          "_calibrationShiftNm": 0,
          "_gain": 1,
          "_offset": 0,
          "_noiseEnabled": true,
          "_shotNoiseFactor": 0.01,
          "_readNoise": 0.002,
          "_seed": 1
        }
      },
      {
        "id": "chart",
        "label": "LIBS spectrum",
        "typeId": "Viz.Plot:xy",
        "data": {
          "enabled": true,
          "_title": "LIBS spectrum, physical model (NIST ASD 5.12)",
          "_xLabel": "wavelength (nm)",
          "_yLabel": "intensity (eV/s per atom)",
          "_maxPoints": 2000,
          "_seriesNames": "measured, ideal"
        }
      }
    ],
    "connections": [
