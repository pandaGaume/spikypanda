# Ignore node_modules and dependencies
node_modules/
package-lock.json
pnpm-lock.yaml
yarn.lock

# Ignore TypeScript build outputs
dist/
build/
bundle/
out/
*.js
*.js.map
*.d.ts

# Track hand-written browser code under packages/host/www (samples and shared
# scripts). Generated bundles still live under packages/host/www/bundle/ which
# is already excluded by the `bundle/` rule above.
!/packages/host/www/samples/
!/packages/host/www/samples/**
!/packages/host/www/js/
!/packages/host/www/js/**

# Ignore IDE/editor-specific files
.vscode/
.idea/
*.code-workspace

# Ignore system files
.DS_Store
Thumbs.db

# Ignore logs and temporary files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Ignore TypeScript cache and ESLint cache
*.tsbuildinfo
.eslintcache

# Ignore WebGPU/WebGL specific cache files
.cache/
.gpu_cache/

# Ignore downloaded datasets
data/

# Keep reproducibility bundles for committed R&D experiments.
!docs/research/motor-current-snn-ablation-2026-08-27/data/
!docs/research/motor-current-snn-ablation-2026-08-27/data/*.json

# Ignore test coverage
coverage/

# Ignore environment files
.env
.env.local
.env.*.local

#Ignore internal doc and data
internals/
.claude/


#private applications
/packages/dev/applications/privates/**

#private tests (confidential work)
/packages/tests/privates/**

#private working docs (drafts, internal, not for public repo)
/helios/private/**

# do not ignore the node-editor-v2.js file in the node-editor-v2 package
!/packages/host/www/node-editor-v2/node-editor-v2.js
