{
    "extends": "../../tsconfig.build.json",
    "compilerOptions": {
        "baseUrl": "..",
        "noEmit": true,
        "declaration": false,
        "sourceMap": false,
        "inlineSources": false,
        "paths": {
            "spikypanda-core":         ["dev/core/src/index.ts"],
            "spikypanda-core/*":       ["dev/core/src/*"],
            "spikypanda-onnx":      ["dev/onnx/src/index.ts"],
            "spikypanda-onnx/*":    ["dev/onnx/src/*"],
            "spikypanda-sensors":      ["dev/sensors/src/index.ts"],
            "spikypanda-sensors/*":    ["dev/sensors/src/*"],
            "spikypanda-nodeeditor":   ["dev/nodeeditor/src/index.ts"],
            "spikypanda-nodeeditor/*": ["dev/nodeeditor/src/*"],
            "spikypanda-applications-mpc":      ["dev/applications/mpc/src/index.ts"],
            "spikypanda-applications-mpc/*":    ["dev/applications/mpc/src/*"],
            "spikypanda-applications-cardriver":   ["dev/applications/privates/cardriver/src/index.ts"],
            "spikypanda-applications-cardriver/*": ["dev/applications/privates/cardriver/src/*"]
        }
    },
    "include": ["**/*.ts"]
}
