{
    "name": "@spiky-panda/plugin-control",
    "version": "0.1.1",
    "license": "BUSL-1.1",
    "description": "Control-systems plugin for SpikyPanda: feedback/delay primitives, signal hold/sample/quantize, future PID/MPC building blocks.",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": ["dist", "bundle", "src", "manifest.json"],
    "scripts": {
        "build":       "npm run clean && npm run compile",
        "clean":       "rimraf dist bundle tsconfig.build.tsbuildinfo",
        "compile":     "tsc -b tsconfig.build.json && node ../../../../scripts/fix-esm-dist.mjs .",
        "watch":       "tsc -b tsconfig.build.json -w",
        "bundle":      "webpack --mode production --config webpack.config.cjs",
        "bundle:dev":  "webpack --mode development --config webpack.config.cjs"
    },
    "sideEffects": false,
    "dependencies": {
        "@spiky-panda/core":     "*",
        "@spiky-panda/nodeeditor": "*"
    },
    "devDependencies": {
        "rimraf":    "~6.0.1",
        "ts-loader": "^9.5.0"
    }
}
