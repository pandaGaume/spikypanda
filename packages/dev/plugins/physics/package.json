{
    "name": "@spiky-panda/plugin-physics",
    "version": "0.1.0",
    "license": "BUSL-1.1",
    "description": "Physics plugin for SpikyPanda: thematic sub-plugins covering electric, mechanical, thermal and fluid phenomena. V1 ships Physics.Electric.Motor.DC (sim + control + sensor) wired for MCSA pipelines.",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": ["dist", "bundle", "src", "manifest.json", "manifests"],
    "scripts": {
        "build":      "npm run clean && npm run compile",
        "clean":      "rimraf dist bundle tsconfig.build.tsbuildinfo",
        "compile":    "tsc -b tsconfig.build.json && node ../../../../scripts/fix-esm-dist.mjs .",
        "watch":      "tsc -b tsconfig.build.json -w",
        "bundle":     "webpack --mode production --config webpack.config.cjs",
        "bundle:dev": "webpack --mode development --config webpack.config.cjs"
    },
    "sideEffects": false,
    "dependencies": {
        "@spiky-panda/core": "*"
    },
    "devDependencies": {
        "@spiky-panda/nodeeditor": "*",
        "rimraf": "~6.0.1",
        "ts-loader": "^9.5.0"
    }
}
