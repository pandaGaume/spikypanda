{
    "name": "@spikypanda/plugin-geometry",
    "version": "0.1.0",
    "description": "Geometry plugin for SpikyPanda: 3D transforms, attitude (Euler angles to quaternion).",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": ["dist", "bundle", "src", "manifest.json"],
    "scripts": {
        "build":       "npm run clean && npm run compile",
        "clean":       "rimraf dist bundle tsconfig.build.tsbuildinfo",
        "compile":     "tsc -b tsconfig.build.json",
        "watch":       "tsc -b tsconfig.build.json -w",
        "bundle":      "webpack --mode production --config webpack.config.cjs",
        "bundle:dev":  "webpack --mode development --config webpack.config.cjs"
    },
    "sideEffects": false,
    "dependencies": {
        "@spiky-panda/core": "*",
        "@spikypanda/nodeeditor": "*"
    },
    "devDependencies": {
        "rimraf":    "~6.0.1",
        "ts-loader": "^9.5.0"
    }
}
