{
    "extends": "../../../../tsconfig.build.json",
    "compilerOptions": {
        "composite": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "skipLibCheck": true,
        "noUnusedLocals": false,
        "paths": {
            "spikypanda-core":          ["dev/core/src/index.ts"],
            "spikypanda-core/*":        ["dev/core/src/*"],
            "spikypanda-nodeeditor":    ["dev/nodeeditor/src/index.ts"],
            "spikypanda-nodeeditor/*":  ["dev/nodeeditor/src/*"],
            "spikypanda-onnx":          ["dev/onnx/src/index.ts"],
            "spikypanda-onnx/*":        ["dev/onnx/src/*"]
        }
    },
    "references": [
        { "path": "../../core/tsconfig.build.json" },
        { "path": "../../nodeeditor/tsconfig.build.json" },
        { "path": "../../onnx/tsconfig.build.json" }
    ],
    "include": ["./src/**/*.ts"],
    "exclude": ["**/node_modules", "**/dist"]
}
