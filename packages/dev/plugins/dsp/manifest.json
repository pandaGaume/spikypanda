{
    "id":          "spk.dsp",
    "version":     "0.2.0",
    "displayName": "DSP",
    "description": "Time-series DSP fundamentals organized as 6 sub-plugins under DSP.*: Transform, Window, Frame, Feature, Filter, Stats. Every node is an ONNX kernel; a subset also has UE5 Audio counterparts.",
    "category":    "DSP",
    "entry":       "bundle/SpkPluginDsp.js",
    "nodes":       [],
    "editors":     [],
    "subPlugins": [
        {
            "id":          "DSP.Generator",
            "displayName": "Generator",
            "description": "Signal sources. Oscillator emits amplitude·sin/cos(2π·f·t + φ) one sample per tick; f, A, φ available as editables AND as optional input ports (wire a slider to frequency for live sweeps). Compose multi-frequency signals with Add trees: Osc1+Osc2+Osc3 -> Buffer -> FFT.",
            "category":    "DSP.Generator",
            "version":     "0.1.0",
            "standards":   [],
            "nodes": [
                { "type": "DSP.Generator:oscillator", "factory": "createOscillatorNode", "label": "Oscillator" }
            ]
        },
        {
            "id":          "DSP.Transform",
            "displayName": "Transforms",
            "description": "FFT (power/magnitude/complex modes), IFFT, Magnitude, Phase, DCT.",
            "category":    "DSP.Transform",
            "version":     "0.1.0",
            "standards":   [{ "id": "onnx", "version": "1.18" }],
            "nodes": [
                { "type": "DSP.Transform:fft",       "factory": "createFftNode",       "label": "FFT" },
                { "type": "DSP.Transform:ifft",      "factory": "createIfftNode",      "label": "IFFT" },
                { "type": "DSP.Transform:magnitude", "factory": "createMagnitudeNode", "label": "Magnitude" },
                { "type": "DSP.Transform:phase",     "factory": "createPhaseNode",     "label": "Phase" },
                { "type": "DSP.Transform:dct",       "factory": "createDctNode",       "label": "DCT" }
            ]
        },
        {
            "id":          "DSP.Window",
            "displayName": "Window",
            "description": "Window function (Hann, Hamming, Blackman, Bartlett, Rectangular, Tukey) selected via the window_type attribute.",
            "category":    "DSP.Window",
            "version":     "0.1.0",
            "standards":   [{ "id": "onnx", "version": "1.18" }],
            "nodes": [
                { "type": "DSP.Window:window", "factory": "createWindowNode", "label": "Window" }
            ]
        },
        {
            "id":          "DSP.Frame",
            "displayName": "Frame",
            "description": "Signal slicing into overlapping frames with hop_length and pad_mode.",
            "category":    "DSP.Frame",
            "version":     "0.1.0",
            "standards":   [{ "id": "onnx", "version": "1.18" }],
            "nodes": [
                { "type": "DSP.Frame:frame", "factory": "createFrameNode", "label": "Frame" }
            ]
        },
        {
            "id":          "DSP.Feature",
            "displayName": "Audio features",
            "description": "Audio-style feature extraction: Mel filterbank, LogScale, MFCC pipeline, DTW distance.",
            "category":    "DSP.Feature",
            "version":     "0.1.0",
            "standards":   [{ "id": "onnx", "version": "1.18" }],
            "nodes": [
                { "type": "DSP.Feature:mel",      "factory": "createMelFilterbankNode", "label": "Mel Filterbank" },
                { "type": "DSP.Feature:logscale", "factory": "createLogScaleNode",      "label": "Log Scale" },
                { "type": "DSP.Feature:mfcc",     "factory": "createMfccNode",          "label": "MFCC" },
                { "type": "DSP.Feature:dtw",      "factory": "createDtwNode",           "label": "DTW" }
            ]
        },
        {
            "id":          "DSP.Filter",
            "displayName": "Filters",
            "description": "Biquad (LP/HP/BP/Notch via filter_type) and scalar Kalman 1D.",
            "category":    "DSP.Filter",
            "version":     "0.1.0",
            "standards":   [{ "id": "onnx", "version": "1.18" }],
            "nodes": [
                { "type": "DSP.Filter:biquad",   "factory": "createBiquadFilterNode", "label": "Biquad Filter" },
                { "type": "DSP.Filter:kalman1d", "factory": "createKalman1DNode",     "label": "Kalman 1D" }
            ]
        },
        {
            "id":          "DSP.Stats",
            "displayName": "Stats",
            "description": "Output-side signal analysis: RMS, Zero-Crossing Rate, Moving Average (causal), Detrend (constant/linear).",
            "category":    "DSP.Stats",
            "version":     "0.1.0",
            "standards":   [{ "id": "onnx", "version": "1.18" }],
            "nodes": [
                { "type": "DSP.Stats:rms",     "factory": "createRmsNode",              "label": "RMS" },
                { "type": "DSP.Stats:zcr",     "factory": "createZeroCrossingRateNode", "label": "Zero Crossing Rate" },
                { "type": "DSP.Stats:movavg",  "factory": "createMovingAverageNode",    "label": "Moving Average" },
                { "type": "DSP.Stats:detrend", "factory": "createDetrendNode",          "label": "Detrend" }
            ]
        },
        {
            "id":          "DSP.Stream",
            "displayName": "Stream",
            "description": "Scalar ↔ tensor adapters. Buffer collects N consecutive float samples and emits a 1D Float32Array tensor every hopLength samples — the missing piece to feed a streaming scalar source (Clock, Sin, sensor) into a tensor-consuming DSP pipeline (SpFrame, SpFFT, ...). Not ONNX-backed: pure runtime impedance matching.",
            "category":    "DSP.Stream",
            "version":     "0.1.0",
            "standards":   [],
            "nodes": [
                { "type": "DSP.Stream:buffer", "factory": "createScalarBufferNode", "label": "Scalar Buffer" }
            ]
        }
    ],
    "manifestRefs": []
}
