{
    "extends": "../../../tsconfig.build.json",
    "compilerOptions": {
        "composite": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "lib": ["es2022"],
        "types": ["node"],
        "skipLibCheck": true,
        "noUnusedLocals": false
    },
    "include": [
        "./src/research/**/*.ts",
        "./src/projects/**/*.ts"
    ],
    "exclude": ["**/node_modules", "**/dist"]
}
