{
    "extends": "../../../tsconfig.build.json",
    "compilerOptions": {
        "composite": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "skipLibCheck": true,
        "noUnusedLocals": false
    },
    "include": [
        "./src/browser-index.ts",
        "./src/types/**/*.ts",
        "./src/adapters/**/*.ts",
        "./src/behaviors/**/*.ts"
    ],
    "exclude": ["**/node_modules", "**/dist", "./src/research/**", "./src/projects/**"]
}
