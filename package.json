{
    "name": "@spikypanda/root",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/**/*"
    ],
    "engines": {
        "node": ">=20.11.0 <23.0.0",
        "npm": ">=8.0.0"
    },
    "scripts": {
        "build:dev": "tsc -b",
        "build:watch": "tsc -b --watch",
        "lint:check": "eslint packages/**/src/**/*.{ts,tsx,js,json}",
        "lint:fix": "eslint --fix packages/**/src/**/*.ts",
        "format:check": "prettier --check packages/**/src/**/*.{ts,tsx,js,json,scss,css}",
        "format:fix": "prettier --write packages/**/src/**/*.{ts,tsx,js,json,scss,css}",
        "bundle": "npm run bundle --workspace=@spiky-panda/core",
        "bundle:dev": "npm run bundle:dev --workspace=@spiky-panda/core",
        "bundle:mcp": "npm run bundle --workspace=@spiky-panda/mcp",
        "bundle:mcp:dev": "npm run bundle:dev --workspace=@spiky-panda/mcp",
        "bundle:sensors": "npm run bundle --workspace=@spiky-panda/sensors",
        "bundle:sensors:dev": "npm run bundle:dev --workspace=@spiky-panda/sensors",
        "build:mcp:research": "npm run compile:research --workspace=@spiky-panda/mcp",
        "deploy:bundles": "node scripts/deploy-bundles.mjs",
        "deploy:mcp-bundles": "node scripts/deploy-mcp-bundles.mjs",
        "prepare:mnist": "node scripts/prepare-mnist.mjs",
        "publish:npm:core": "node scripts/publish.mjs",
        "build:all": "npm run build:dev && npm run bundle && npm run deploy:bundles",
        "build:all:dev": "npm run build:dev && npm run bundle:dev && npm run deploy:bundles",
        "build:mcp": "npm run build:dev && npm run bundle:mcp && npm run deploy:bundles && npm run deploy:mcp-bundles",
        "build:sensors": "npm run build:dev && npm run bundle:sensors && npm run deploy:bundles",
        "build:sensors:dev": "npm run build:dev && npm run bundle:sensors:dev && npm run deploy:bundles",
        "server": "node --import ./packages/host/loader-register.mjs packages/host/server.mjs",
        "test": "jest --passWithNoTests",
        "test:watch": "jest --watch"
    },
    "dependencies": {
        "@spikypanda/root": "file:.claude/worktrees/funny-chaum-69251c",
        "@dev/core": "file:../Gaume/mcp-for-babylon/packages/dev/core",
        "@dev/tunnel": "file:../Gaume/mcp-for-babylon/packages/dev/tunnel",
        "reflect-metadata": "^0.2.2",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^18.15.10",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "cross-env": "^7.0.3",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.0",
        "jest": "^29.5.0",
        "lint-staged": "^15.0.0",
        "prettier": "^3.2.0",
        "rimraf": "~6.0.1",
        "ts-jest": "^29.1.0",
        "ts-node": "^10.9.1",
        "typescript": "^5.4.0",
        "webpack": "^5.98.0",
        "webpack-cli": "^5.1.0"
    },
    "lint-staged": {
        "*.ts": [
            "eslint --fix",
            "prettier --write"
        ]
    }
}
